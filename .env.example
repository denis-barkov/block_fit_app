PROJECT_NAME=blockfit-nyc
MANAGED_BY=script
SERVICE_PART=infra
FUNDING=personal

# Shared OpenAI model and conservative Standard-tier token rates (microdollars per million).
# The input rate covers the default 30-minute prompt-cache write price.
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=low
AI_INPUT_MICROUSD_PER_MILLION=2500000
AI_OUTPUT_MICROUSD_PER_MILLION=10000000
