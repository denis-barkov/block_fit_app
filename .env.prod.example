DEPLOYMENT=prod
# Provisioning obtains the assigned hostname from Pages. Optional APP_ORIGIN pins that exact origin.
PAGES_PROJECT_NAME=blockfit-demo
APP_ORIGIN=
CONTACT_EMAIL=
CLOUDFLARE_ACCOUNT_ID=
# Wrangler OAuth is used when this optional full deployment token is blank.
CLOUDFLARE_API_TOKEN=
# When using Wrangler OAuth, supply an account-owned token scoped to Resource Tagging.
CLOUDFLARE_TAG_API_TOKEN=
# Optional suffix for a parallel installation. Use lowercase letters, digits or hyphens.
DEPLOYMENT_SUFFIX=
AUTH_SECRET=
# Live AI is opt-in. Set a project API key.
AI_ENABLED=false
OPENAI_API_KEY=
