{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["vite/client", "node", "@cloudflare/workers-types"],
    "strict": true, "jsx": "react-jsx", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "noEmit": true
  },
  "include": ["config", "src", "tests", "*.ts"]
}
